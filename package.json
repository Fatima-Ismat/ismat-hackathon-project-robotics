{
  "name": "physical-ai-robotics-book",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    
   
    "hf:login": "huggingface-cli login",
    "hf:push": "cd ../Rag-chatbot-space && git add . && git commit -m \"Backend update\" && git push origin main",
    "hf:status": "curl -s https://ismat110-rag-chatbot.hf.space/",
    "hf:test": "curl -X POST \"https://ismat110-rag-chatbot.hf.space/chat\" -H \"Content-Type: application/json\" -d \"{\\\"message\\\":\\\"Hello\\\",\\\"session_id\\\":\\\"test123\\\",\\\"language\\\":\\\"en\\\"}\"",
    "hf:logs": "echo \"Open: https://huggingface.co/spaces/ismat110/Rag-chatbot/logs\"",
    
    
    "deploy:all": "npm run build && npm run deploy && npm run hf:push",
    "deploy:frontend": "npm run build && npm run deploy",
    "deploy:backend": "npm run hf:push",
    
    
    "test:backend": "npm run hf:status",
    "test:chat": "npm run hf:test",
    "test:all": "npm run test:backend && echo '✅ Backend healthy'",
    
    
    "dev:frontend": "npm start",
    "dev:clean": "npm run clear && rm -rf node_modules/.cache",
    "dev:full": "npm run dev:clean && npm start",
    
    
    "info:urls": "echo \"Frontend: https://fatima-ismat.github.io/ismat-hackathon-project-robotics/\" && echo \"Backend: https://ismat110-rag-chatbot.hf.space\"",
    "info:docs": "echo \"API Docs: https://ismat110-rag-chatbot.hf.space/docs\""
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/tsconfig": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}